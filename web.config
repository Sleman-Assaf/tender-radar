<?xml version="1.0" encoding="UTF-8"?>
<!--
  Path: TenderRadar/web.config
  IIS configuration for TenderRadar — HTTPS + Waitress reverse proxy
  Place this file in the IIS site root (same folder as manage.py)
-->
<configuration>
  <system.webServer>

    <!-- ── URL Rewrite: Force HTTPS ────────────────────────────────── -->
    <rewrite>
      <rules>
        <!-- Redirect all HTTP to HTTPS -->
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="https://{HTTP_HOST}/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- Proxy all HTTPS requests to Waitress on port 8005.
             Must match the PORT default in serve_http.py / start_http.bat. -->
        <rule name="Proxy to Waitress" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^ON$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8005/{R:1}" />
          <serverVariables>
            <!-- Tell Django it's behind HTTPS proxy -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST"  value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <!-- ── Security Headers ────────────────────────────────────────── -->
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security"
             value="max-age=31536000; includeSubDomains; preload" />
        <add name="X-Content-Type-Options"    value="nosniff" />
        <add name="X-Frame-Options"           value="SAMEORIGIN" />
        <add name="X-XSS-Protection"          value="1; mode=block" />
        <add name="Referrer-Policy"           value="strict-origin-when-cross-origin" />
        <!-- Remove server banner -->
        <remove name="X-Powered-By" />
        <remove name="Server" />
      </customHeaders>
    </httpProtocol>

    <!-- ── Static files served directly by IIS (bypass Waitress) ─── -->
    <staticContent>
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".woff"  mimeType="font/woff"  />
    </staticContent>

    <!-- ── Error pages ─────────────────────────────────────────────── -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
